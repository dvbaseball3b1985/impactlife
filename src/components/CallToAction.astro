---
interface Props {
  title: string;
  text: string;
  href: string;
  label: string;
}
const { title, text, href, label } = Astro.props;
---

<section class="section section--olive">
  <div class="container cta">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn--dark" href={href}>{label}</a>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .cta p { margin: 0; max-width: 55ch; }
</style>
