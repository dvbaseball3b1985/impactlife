---
import { site } from '../data/site';

interface Props {
  platform: 'facebook' | 'instagram';
  size?: number;
  label?: boolean;
}
const { platform, size = 28, label = false } = Astro.props;

const platforms = {
  facebook: { name: 'Facebook', href: site.facebook, hover: '#1877f2' },
  instagram: { name: 'Instagram', href: site.instagram, hover: '#e1306c' },
};
const p = platforms[platform];
---

<a
  class="social"
  href={p.href}
  target="_blank"
  rel="noopener"
  aria-label={label ? undefined : `${site.name} on ${p.name}`}
  style={`--hover: ${p.hover}`}
>
  {platform === 'facebook' && (
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="currentColor">
      <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
    </svg>
  )}
  {platform === 'instagram' && (
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="2" width="20" height="20" rx="5.5" />
      <circle cx="12" cy="12" r="4.5" />
      <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
    </svg>
  )}
  {label && <span>{p.name}</span>}
</a>

<style>
  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .social svg { flex-shrink: 0; transition: color 0.15s; }
  .social:hover svg { color: var(--hover); }
</style>
